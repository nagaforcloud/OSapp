# .env.example
# Copy this file to .env and fill in your actual values

# Mistral AI API Key (required for Mistral mode)
# Get your API key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# DeepSeek API Key (required for DeepSeek mode)
# Get your API key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Qwen Coder Plus API Key (required for Qwen mode)
# Note: Qwen Coder Plus support is not yet implemented
QWEN_CODER_API_KEY=your_qwen_coder_api_key_here

# LangChain API Key (optional but recommended)
# Get your API key at https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Document directory (optional, defaults to data/documents)
DOCUMENTS_DIR=data/documents

# Qdrant database path (optional, defaults to vector_db)
QDRANT_PATH=vector_db

# Chunk size for document splitting (optional, defaults to 1000)
CHUNK_SIZE=1000

# Chunk overlap for document splitting (optional, defaults to 200)
CHUNK_OVERLAP=200

# LLM model to use (optional, defaults to deepseek-chat)
LLM_MODEL=deepseek-chat

# Embedding model to use (optional, defaults to deepseek-embedding)
EMBEDDING_MODEL=deepseek-embedding

# Qwen Coder Plus model (not yet implemented)
QWEN_CODER_MODEL=qwen-coder-plus

# Number of documents to retrieve (optional, defaults to 4)
TOP_K=4

# Local LLM Settings (for llama.cpp)
# Path to your GGUF model file for local LLM
# Recommended 4B parameter model: models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
# Download from: https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.2-GGUF
LOCAL_LLM_MODEL_PATH=models/mistral-7b-instruct-v0.2.Q4_K_M.gguf

# Path to your GGUF model file for local embeddings (optional)
# Recommended embedding model: models/bge-small-en-v1.5-q4_k_m.gguf
# Download from: https://huggingface.co/CompendiumLabs/bge-small-en-v1.5-gguf
# If left empty, the LLM model will be used for embeddings
LOCAL_EMBEDDING_MODEL_PATH=models/bge-small-en-v1.5-q4_k_m.gguf

# Local LLM parameters
LOCAL_LLM_CONTEXT_SIZE=2048
LOCAL_LLM_MAX_TOKENS=2000
LOCAL_LLM_TEMPERATURE=0.7