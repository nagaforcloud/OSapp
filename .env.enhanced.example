# .env.enhanced.example
# Enhanced environment variables for the Onestream RAG Assistant
# Copy this file to .env and fill in your actual values

# ===========================================
# LOCAL MODEL CONFIGURATION
# ===========================================
# Path to your local LLM model file (GGUF format)
LOCAL_LLM_MODEL_PATH=./models/mistral-7b-instruct.gguf

# Path to your local embedding model file (GGUF format)
LOCAL_EMBEDDING_MODEL_PATH=./models/bge-small-v1.5.gguf

# Local model parameters
LOCAL_MODEL_N_CTX=4096
LOCAL_MODEL_N_GPU_LAYERS=0
LOCAL_MODEL_TEMPERATURE=0.7
LOCAL_MODEL_MAX_TOKENS=2048

# ===========================================
# CLOUD API KEYS (Optional)
# ===========================================
# DeepSeek API configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Mistral AI API configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-medium

# OpenAI API configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Qwen Coder Plus API configuration
QWEN_CODER_API_KEY=your_qwen_api_key_here
QWEN_CODER_MODEL=qwen-coder-plus

# LangChain API (for tracing and monitoring)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=onestream-rag

# ===========================================
# VECTOR DATABASE CONFIGURATION
# ===========================================
# Qdrant vector database settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=onestream_documents

# Vector store configuration
VECTOR_STORE_TYPE=qdrant  # Options: qdrant, pgvector
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.7
MAX_SEARCH_RESULTS=10

# Legacy settings
QDRANT_PATH=vector_db
DOCUMENTS_DIR=data/documents

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Redis for caching and session management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Cache configuration
CACHE_TTL=3600  # Cache TTL in seconds (1 hour)
CACHE_MAX_SIZE=1000  # Maximum cache entries

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Flask/Streamlit configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=production
DEBUG=false

# Server configuration
HOST=0.0.0.0
PORT=8501
FLASK_PORT=5000

# Logging configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
STRUCTURED_LOG_FILE=logs/app_structured.log

# LLM configuration
LLM_MODEL=deepseek-chat

# Text chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNK_LENGTH=4000
MIN_CHUNK_LENGTH=100

# Search and retrieval settings
TOP_K=4  # Number of documents to retrieve (defaults to 4)
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7
MAX_SEARCH_RESULTS=10

# RAG configuration
RAG_SYSTEM_PROMPT="You are a helpful assistant specializing in Onestream software. Answer questions based on the provided context. If the context doesn't contain the answer, say so politely."
RAG_MAX_CONTEXT_TOKENS=3000
RAG_RESPONSE_TEMPERATURE=0.7

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Authentication
ADMIN_PASSWORD=admin  # Change this in production!
SESSION_TIMEOUT=3600  # Session timeout in seconds
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=900  # 15 minutes

# Rate limiting
GLOBAL_RATE_LIMIT=1000  # requests per hour
IP_RATE_LIMIT=100  # requests per 5 minutes
USER_RATE_LIMIT=200  # requests per 30 minutes
AUTH_RATE_LIMIT=5  # login attempts per 15 minutes
UPLOAD_RATE_LIMIT=10  # uploads per hour

# File upload settings
MAX_CONTENT_LENGTH=50MB  # Maximum file upload size
ALLOWED_EXTENSIONS=pdf,txt,md,docx,doc,xlsx,xls,pptx,ppt
UPLOAD_FOLDER=uploads

# ===========================================
# DOCUMENT PROCESSING
# ===========================================
# Document processing settings
DOCUMENT_FOLDER=data/documents
PROCESSED_FOLDER=data/processed
SUPPORTED_FORMATS=pdf,txt,md,docx,doc,xlsx,xls,pptx,ppt

# PDF processing settings
PDF_PROCESSING_THREADS=4
PDF_OCR_ENABLED=false
PDF_OCR_LANG=eng

# ===========================================
# MONITORING AND HEALTH CHECKS
# ===========================================
# Health check settings
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
COMPONENT_HEALTH_CHECKS=true

# Metrics and monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics

# Performance monitoring
SLOW_QUERY_THRESHOLD=5.0  # seconds
SLOW_UPLOAD_THRESHOLD=30.0  # seconds
MEMORY_WARNING_THRESHOLD=80  # percentage
CPU_WARNING_THRESHOLD=80  # percentage

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Development mode settings (set to true for local development)
DEVELOPMENT=false
RELOAD_ON_CHANGE=true
SHOW_DEBUG_INFO=true

# Testing settings
TESTING=false
MOCK_EXTERNAL_APIS=false
SKIP_AUTH_IN_TESTS=true

# ===========================================
# LOCAL LLM SETTINGS (Advanced)
# ===========================================
# Local LLM parameters
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TEMPERATURE=0.7